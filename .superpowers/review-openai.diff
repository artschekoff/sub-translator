+	var mu sync.Mutex
+	var seen [][2]int
+	_, failed, err := c.TranslateAll(texts, func(done, total int) {
+		mu.Lock()
+		defer mu.Unlock()
+		seen = append(seen, [2]int{done, total})
+	})
