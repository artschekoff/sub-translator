 // Keys returns every valid config key, sorted, for `config list` and for the
 // "did you mean" list in errors.
 func Keys() []string {
 	keys := make([]string, 0, len(fields))
 	for k := range fields {
 		keys = append(keys, k)
 	}
 	slices.Sort(keys)
